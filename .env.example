# Instagram Graph API credentials
# Get these from your Meta Developer App (https://developers.facebook.com/)
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here
INSTAGRAM_USER_ID=your_instagram_business_user_id_here

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# How often to check for new followers (in seconds). Default: 60
POLL_INTERVAL_SECONDS=60

# Optional: customize the welcome message tone
# e.g. "friendly and casual", "professional", "enthusiastic"
WELCOME_TONE=friendly and warm
